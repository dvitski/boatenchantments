{
	"schemaVersion": 1,
	"id": "enchantedsails",
	"version": "${version}",
	"name": "Enchanted Sails",
	"description": "Enchantments for your boats!",
	"authors": [
		"dvitski"
	],
	"contact": {
		"homepage": "https://dvitski.cc",
        "sources": "https://github.com/dvitski/enchantedsails",
        "issues": "https://github.com/dvitski/enchantedsails/issues"
	},
	"license": "MIT",
	"icon": "assets/enchantedsails/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "cc.dvitski.enchantedsails.EnchantedSails",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "cc.dvitski.enchantedsails.client.EnchantedSailsClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "cc.dvitski.enchantedsails.data.EnchantedSailsDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"enchantedsails.mixins.json",
		{
			"config": "enchantedsails.client.mixins.json",
			"environment": "client"
		}
	],
    "accessWidener": "enchantedsails.accesswidener",
	"depends": {
		"minecraft": "~1.21.11-beta",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}
